# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` at the repository root. Every app reads this single file and
# validates only the keys it needs at boot (see packages/platform/config).
# Both compose files (docker-compose.dev.yaml, docker-compose.prod.yaml) read it
# too and hand each container only the keys that service needs.
# Values below are for development; `# prod:` notes say what production changes
# (docs/guides/run-with-docker.md lists them all).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# api, worker and scheduler only: the web app's build/start scripts pin production.
# The compose files set it per environment; this value is for apps run on the host.
NODE_ENV=development
# fatal | error | warn | info | debug | trace          prod: info
LOG_LEVEL=debug

# ── Docker network ───────────────────────────────────────────────────────────
# Every service has the same fixed address in dev and prod. The server-side URLs
# below use them. From the host they are reachable on Linux only: on Docker
# Desktop (macOS, Windows) point host-run tools at the localhost ports instead.
# docker/prod/config/database/pg_hba.conf and nginx/nginx.conf repeat some of
# them: change an address there too.
DOCKER_SUBNET=192.168.250.0/24
DOCKER_GATEWAY=192.168.250.1
DATABASE_IP=192.168.250.10
REDIS_IP=192.168.250.11
S3_IP=192.168.250.12
MIGRATOR_IP=192.168.250.20
API_IP=192.168.250.30
WORKER_IP=192.168.250.31
SCHEDULER_IP=192.168.250.32
WEB_IP=192.168.250.40
NGINX_IP=192.168.250.50
CLOUDFLARED_IP=192.168.250.51

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=template
# prod: openssl rand -hex 32 (and the same in DATABASE_URL)
POSTGRES_PASSWORD=template
POSTGRES_DB=template
# Dev only: host port the database is published on (127.0.0.1).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://template:template@192.168.250.10:5432/template
# Used by integration and e2e suites (created by docker/dev/config/database/init).
DATABASE_TEST_URL=postgresql://template:template@192.168.250.10:5432/template_test

# ── Redis ────────────────────────────────────────────────────────────────────
# Dev only: host port Redis is published on (127.0.0.1).
REDIS_PORT=6379
# Prod only (dev Redis has none): openssl rand -hex 32. Then REDIS_URL=redis://:<password>@192.168.250.11:6379
REDIS_PASSWORD=
REDIS_URL=redis://192.168.250.11:6379

# ── Object storage (S3 API: RustFS in both compose files, any S3-compatible service works) ─
# Dev only: host ports of RustFS, S3 API and web console (sign in with the keys below).
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Where the api, worker and migrator reach the S3 API. Leave empty on AWS to use the regional endpoint.
S3_ENDPOINT=http://192.168.250.12:9000
# Where browsers reach it: presigned upload and download URLs are signed for this origin.
# prod: https://s3.example.com (nginx routes the `s3.` subdomain to RustFS)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# RustFS is created with these as its root credentials, which the apps use too.
# prod: long random values (openssl rand -hex 32). On AWS, a key scoped to the bucket's
# objects, or leave both empty to use the AWS default credential chain.
S3_ACCESS_KEY_ID=template
S3_SECRET_ACCESS_KEY=template-secret
# RustFS (without RUSTFS_SERVER_DOMAINS), MinIO and most self-hosted services need path-style URLs.
S3_FORCE_PATH_STYLE=true
S3_BUCKET=template
# Used by integration suites, which create it (`nx run storage:provision-test`) and empty it.
S3_TEST_BUCKET=template-test

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# prod: https://api.example.com
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of origins allowed to call the API with credentials.  prod: https://example.com
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /docs.  prod: false
SWAGGER_ENABLED=true
# Requests allowed per IP per window.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Set to true behind a reverse proxy so client IPs come from X-Forwarded-For.  prod: true (nginx)
TRUST_PROXY=false

# ── Cookies ──────────────────────────────────────────────────────────────────
# Parent domain shared by web and API in production.  prod: example.com
COOKIE_DOMAIN=localhost
# prod: true
COOKIE_SECURE=false

# ── Identity ─────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=template-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Mail ─────────────────────────────────────────────────────────────────────
# resend  : real delivery through Resend (default, also in development)
# console : log emails instead of sending them
# capture : store emails in a Redis outbox read by e2e suites
MAIL_TRANSPORT=resend
RESEND_API_KEY=
# Without a verified domain Resend only delivers from onboarding@resend.dev
# to the address of your own Resend account.
MAIL_FROM=Template <onboarding@resend.dev>

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=5

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_HEALTH_PORT=4200

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Public URL of the web app: used in emails, canonical URLs and the sitemap.  prod: https://example.com
WEB_APP_URL=http://localhost:3000
# Inlined into the web bundle at build time: the prod web image is built for one environment.
# prod: https://api.example.com and https://example.com
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Production only (docker-compose.prod.yaml) ───────────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token of `cloudflared tunnel run`.
CLOUDFLARE_TUNNEL_TOKEN=
# Where `docker compose pull` gets the images (the Release workflow publishes them to GHCR), and
# which release: a version tag such as 1.4.0. `docker compose build` tags local builds the same.
IMAGE_REGISTRY=ghcr.io/damienreichhart/template-fullstack-typescript-production
IMAGE_TAG=local
