# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` at the repository root. Every app reads this single file and
# validates only the keys it needs at boot (see packages/platform/config).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# api, worker and scheduler only: the web app's build/start scripts pin production.
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=template
POSTGRES_PASSWORD=template
POSTGRES_DB=template
POSTGRES_PORT=5432
DATABASE_URL=postgresql://template:template@localhost:5432/template
# Used by integration and e2e suites (created by docker/postgres/init).
DATABASE_TEST_URL=postgresql://template:template@localhost:5432/template_test

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /docs. Keep false in production.
SWAGGER_ENABLED=true
# Requests allowed per IP per window.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Set to true behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# ── Cookies ──────────────────────────────────────────────────────────────────
# Parent domain shared by web and API in production (e.g. example.com).
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Identity ─────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=template-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ── Mail ─────────────────────────────────────────────────────────────────────
# resend  : real delivery through Resend (default, also in development)
# console : log emails instead of sending them
# capture : store emails in a Redis outbox read by e2e suites
MAIL_TRANSPORT=resend
RESEND_API_KEY=
# Without a verified domain Resend only delivers from onboarding@resend.dev
# to the address of your own Resend account.
MAIL_FROM=Template <onboarding@resend.dev>

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=5

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_HEALTH_PORT=4200

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Public URL of the web app: used in emails, canonical URLs and the sitemap.
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
