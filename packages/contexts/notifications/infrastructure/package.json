    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@template/config": "workspace:*",
    "@template/contracts": "workspace:*",
    "@template/ddd": "workspace:*",
    "@template/i18n": "workspace:*",
    "@template/notifications-application": "workspace:*",
    "@template/redis": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.35.0",
    "use-intl": "4.14.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "reflect-metadata": "0.2.2"
  }
