{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "types": ["bun"],
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
