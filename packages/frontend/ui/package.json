{
  "name": "@template/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./primitives/*": {
      "@template/source": "./src/primitives/*.tsx",
      "types": "./dist/primitives/*.d.ts",
      "default": "./dist/primitives/*.js"
    },
    "./components/*": {
      "@template/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "@template/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "bun --conditions=@template/source test --pass-with-no-tests"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "scope:frontend",
      "type:ui"
    ]
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react-hook-form": "7.89.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
