{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "bun"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules", ".next", "out-tsc", "dist"],
  "references": [
    {
      "path": "../../packages/frontend/ui"
    },
    {
      "path": "../../packages/shared/contracts"
    },
    {
      "path": "../../packages/frontend/api-client"
    },
    {
      "path": "../../packages/shared/i18n"
    }
  ]
}
