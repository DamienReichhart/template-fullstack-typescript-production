{
  "name": "@template/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --conditions=@template/source --env-file=../../.env --watch src/main.ts",
    "start": "bun dist/main.js",
    "test": "bun --conditions=@template/source test --pass-with-no-tests"
  },
  "nx": {
    "name": "worker",
    "tags": [
      "type:app"
    ],
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^prisma-generate"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/cqrs": "12.1.1",
    "@template/config": "workspace:*",
    "@template/database": "workspace:*",
    "@template/health": "workspace:*",
    "@template/identity-application": "workspace:*",
    "@template/identity-infrastructure": "workspace:*",
    "@template/identity-jobs": "workspace:*",
    "@template/logger": "workspace:*",
    "@template/messaging": "workspace:*",
    "@template/notifications-application": "workspace:*",
    "@template/notifications-infrastructure": "workspace:*",
    "@template/notifications-jobs": "workspace:*",
    "@template/redis": "workspace:*",
    "@template/storage": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  }
}
