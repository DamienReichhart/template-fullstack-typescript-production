{
  "name": "@template/source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/shared/*",
    "packages/frontend/*",
    "packages/platform/*",
    "packages/contexts/*/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "nx run-many -t dev -p api worker scheduler web --parallel=4",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:int": "nx run-many -t test:int",
    "e2e": "nx run-many -t e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "bun tools/scripts/check-structure.ts",
    "check:server-logic": "bun tools/scripts/check-no-server-logic.ts",
    "db:generate": "nx run database:prisma-generate",
    "db:migrate": "nx run database:prisma-migrate",
    "db:deploy": "nx run database:prisma-deploy",
    "storage:provision": "nx run storage:provision",
    "docker:up": "docker compose -f docker-compose.dev.yaml up -d --wait database redis s3",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up --build --watch",
    "docker:down": "docker compose -f docker-compose.dev.yaml down",
    "openapi": "nx run api:openapi"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@types/bun": "1.4.4",
    "@types/node": "24",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "multer": "2.5.0",
    "qs": "6.16.1"
  }
}
